# Flattrade API credentials
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Your Flattrade login user ID (e.g. FT12345)
FLATTRADE_USER_ID=

# Your Flattrade login password (plain text — hashed with SHA-256 before sending)
FLATTRADE_PASSWORD=

# Base32 TOTP seed from your authenticator app.
# In Google Authenticator / Authy: tap the account → "Show key" to reveal it.
FLATTRADE_TOTP_SECRET=

# API key — the App Key from Flattrade API dashboard (My Apps → App Key / Client ID)
FLATTRADE_API_KEY=

# API secret key — from Flattrade API dashboard (My Apps → Secret)
FLATTRADE_API_SECRET=

# Optional: override the API base URL if Flattrade changes it
# FLATTRADE_BASE_URL=https://piconnect.flattrade.in/NorenWClientTP

# ── Trade alerts (optional) ────────────────────────────────────────────────
# Leave blank to disable. Each channel activates only when all its keys are set.

# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via Twilio (Console → Messaging → Try WhatsApp for the free sandbox).
# WHATSAPP_TO is your own number in E.164, e.g. +919876543210
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TO=
# Sandbox sender; override only if you own a WhatsApp-enabled Twilio number
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
